{
  "name": "lite-popover",
  "version": "0.1.0",
  "description": "Tiny wrapper over the native Popover API + CSS Anchor Positioning",
  "license": "MIT",
  "author": "akpsan",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akpsan/lite-popover.git"
  },
  "bugs": {
    "url": "https://github.com/akpsan/lite-popover/issues"
  },
  "homepage": "https://github.com/akpsan/lite-popover#readme",
  "keywords": [
    "popover",
    "tooltip",
    "floating-ui",
    "anchor-positioning"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --minify --clean && cp src/style.css dist/style.css",
    "lint": "tsc",
    "test": "vitest run",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "demo": "vite demo",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
